# ─── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://northsea:northsea_dev@localhost:5432/northsea_agentops
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TELEMETRY=well.telemetry
KAFKA_TOPIC_ANOMALIES=well.anomalies
KAFKA_TOPIC_ESCALATIONS=agent.escalations
KAFKA_CONSUMER_GROUP=northsea-agentops

# ─── Agent Configuration ──────────────────────────────────────────────────────
AGENT_CONFIDENCE_THRESHOLD=0.75
AGENT_EVIDENCE_COVERAGE_THRESHOLD=0.60
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=120

# ─── RAG Configuration ────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=640
RAG_CHUNK_OVERLAP=112
RAG_TOP_K=14
# Cosine floor for semantic_search standalone use (hybrid retrieval uses min_similarity=0 for recall).
RAG_SIMILARITY_THRESHOLD=0.52
# Stopword‑aware lexical coverage; below this ⇒ weak_evidence unless relief thresholds also met.
RAG_COVERAGE_WEAK_THRESHOLD=0.38
# Relief: skip weak_evidence when top fused relevance AND coverage exceed these floors simultaneously.
RAG_EVIDENCE_RELIEF_MIN_COVERAGE=0.24
RAG_EVIDENCE_RELIEF_MIN_RELEVANCE=0.18
# Field-aggregate VOLVE workbook questions tilt fusion toward lexical and inject field-overview chunks.
RAG_FIELD_QUERY_BM25_ALPHA=0.42
RAG_LEXICAL_OVERLAP_RERANK_WEIGHT=0.28
RAG_FIELD_OVERVIEW_INJECT_CHUNKS=14
# Optional: alternate model for grounded RAG answers (eval / API). Uses OPENAI_MODEL if unset.
# RAG_COMPLETION_MODEL=gpt-4o
# Minimum fused RRF relevance (0–1); do not set this to cosine values (see code comments).
RAG_MIN_FUSED_SCORE=0.04
RAG_HYBRID_ALPHA=0.55
# After changing chunking defaults or enrichment, re-ingest corpus:
#     .venv/bin/python -m src.rag.ingestion --docs-dir …
#
# Practical KB — real Volve only (recommended):
#     .venv/bin/python scripts/sync_real_volve_daily_rag.py   # wipes RAG docs, corpus, ingest, regenerated golden rows
#
# Synthetic WR scaffold for experiments only (paired with archived legacy synthetic golden JSON):
#     .venv/bin/python scripts/bootstrap_golden_docs_corpus.py

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=northsea-agentops
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Set false on a laptop without docker-compose otel-collector — avoids OTLP retry noise to localhost:4318.
# (docker-compose overrides this to true for the `api` service when using the bundled collector.)
OTEL_EXPORTER_OTLP_ENABLED=false
PROMETHEUS_PORT=9090

# ─── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=northsea-agentops-eval

# ─── Offline benchmark throughput (optional) ────────────────────────────────────
# VOLVE_EVAL_IF_N_ESTIMATORS=200       # Fewer trees ⇒ faster detector eval (clamp 50–512)
# VOLVE_EVAL_PARALLEL_WELLS=1          # Or: python scripts/train_detector_v2.py --parallel-wells N
# RAG_EVAL_GATHER_CONCURRENCY=16       # Concurrent golden-set retrieve + completions (ragas_eval)
# RAG_EVAL_CONTEXT_CHARS=12000           # Characters of retrieved context fed to completion (faithfulness/RAG gate)
# RAG_EVAL_COMPLETION_MODEL=gpt-4o       # Overrides RAG_COMPLETION_MODEL / OPENAI_MODEL for ragas runner
# RAGAS_METRIC_MODEL=gpt-4o              # LLM Ragas metrics (faithfulness, precision, ...)
# RAGAS_MAX_WORKERS=16                   # Ragas metric phase worker cap
# RAGAS_EVAL_TIMEOUT_SECONDS=240

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-me-in-production
API_HOST=0.0.0.0
API_PORT=8000

# ─── Azure (production) ───────────────────────────────────────────────────────
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=
# AZURE_EVENT_HUB_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT_URL=
